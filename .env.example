# Django
SECRET_KEY=dev-only-secret-key-change-me-before-deploying-32chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default for the MVP)
# DATABASE_URL=sqlite:///db.sqlite3
# Example for a future Postgres migration:
# DATABASE_URL=postgres://user:password@localhost:5432/emtelco
DATABASE_URL=sqlite:///db.sqlite3

# CORS (frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM provider (only OpenAI is implemented for the MVP)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Agent behaviour
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_MAX_CONTEXT_MESSAGES=20
AGENT_UNRESOLVED_ATTEMPTS_THRESHOLD=3
AGENT_TEMPORARY_BLOCK_MINUTES=3
AGENT_PERMANENT_BLOCK_AFTER=4
